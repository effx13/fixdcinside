{
  "name": "fixdcinside",
  "version": "0.1.0",
  "private": true,
  "description": "Better dcinside embeds for Discord, Telegram and friends. Runs entirely on Cloudflare Workers - no headless browser.",
  "type": "module",
  "scripts": {
    "build:templates": "node scripts/build-templates.mjs",
    "build:favicon": "node scripts/build-favicon.mjs",
    "dev": "pnpm build:templates && wrangler dev",
    "deploy": "pnpm build:templates && wrangler deploy",
    "typecheck": "pnpm build:templates && tsc --noEmit",
    "test": "pnpm build:templates && vitest run",
    "test:watch": "vitest",
    "lint": "pnpm build:templates && eslint .",
    "lint:fix": "pnpm build:templates && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.4.1",
    "ejs": "^6.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "packageManager": "pnpm@10.33.0"
}
