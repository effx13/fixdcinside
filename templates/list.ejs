<%
/* Embed page for a dcinside gallery listing. See templates/post.ejs. */
-%>
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title><%= it.title %></title>
<meta property="og:type" content="website">
<meta property="og:url" content="<%= it.url %>">
<meta property="og:title" content="<%= it.title %>">
<meta property="og:description" content="<%= it.description %>">
<meta property="og:site_name" content="<%= it.siteName %>">
<meta name="theme-color" content="<%= it.themeColor %>">
<meta name="twitter:card" content="summary">
<link rel="alternate" type="application/json+oembed" href="<%= it.oembedUrl %>" title="<%= it.title %>">
<link rel="canonical" href="<%= it.url %>">
<meta http-equiv="refresh" content="0; url=<%= it.url %>">
</head>
<body><a href="<%= it.url %>">디시인사이드에서 보기</a></body>
</html>
